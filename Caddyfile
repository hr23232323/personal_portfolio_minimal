# Caddyfile - New Portfolio Web Server Configuration

:80 {
	root /srv

	file_server {
		index index.html
	}

	encode gzip

	redir /small-business* / permanent
	redir /smb* / permanent

	header /static/* Cache-Control "public, max-age=31536000, immutable"
	@code path *.js *.css
	header @code Cache-Control "public, max-age=86400"
	header /img/* Cache-Control "public, max-age=604800"
	header /world/assets/* Cache-Control "public, max-age=2592000"

	# Pages always check for a new version, so a deploy reaches returning visitors.
	@pages path / */ *.html
	header @pages Cache-Control "no-cache"

	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header X-XSS-Protection "1; mode=block"
}
